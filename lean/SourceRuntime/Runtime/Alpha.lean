import SourceRuntime.Runtime.Observation
import SourceRuntime.Runtime.Reduction

/-!
Runtime §3, R-Alpha and O-Alpha: consistent fresh renaming of future names.
Exchange traverses every runtime child, leaving source variables and binders fixed.
Map exchange is specified by lookup equations, including absent entries.
States remain explicit-name states; Alpha is the equivalence generated by fresh renamings.
-/

namespace SourceRuntime.Runtime

open WSLN

/-- Reuse the library's transposition on indices, keeping FName separate from source atoms. -/
def FName.exchange (p q r : FName) : FName := ⟨WSLN.swap p.index q.index r.index⟩

@[simp] theorem FName.exchange_exchange (p q r : FName) :
    p.exchange q (p.exchange q r) = r := by
  cases p with | mk p =>
    cases q with | mk q =>
      cases r with | mk r =>
        by_cases hp : p = r <;> by_cases hq : q = r <;> simp_all [FName.exchange, WSLN.swap]

mutual
def exchange (p q : FName) {n} : RawTerm n → RawTerm n
  | .var i => .var i
  | .atom x => .atom x
  | .op (.future r) .nil => future (p.exchange q r)
  | .op (.source o) args => .op (.source o) (exchangeArgs p q args)

def exchangeArgs (p q : FName) {n ms} : Arg signature n ms → Arg signature n ms
  | .nil => .nil
  | .cons t rest => .cons (exchange p q t) (exchangeArgs p q rest)
end

mutual
@[simp] theorem exchange_exchange (p q : FName) {n} (t : RawTerm n) :
    exchange p q (exchange p q t) = t := by
  match t with
  | .var _ | .atom _ => rfl
  | .op (.future r) .nil =>
      change future (p.exchange q (p.exchange q r)) = future r
      rw [FName.exchange_exchange]
  | .op (.source o) args =>
      exact congrArg (Trm.op (Sg := signature) (Op.source o)) (exchangeArgs_exchange p q args)
termination_by structural t

@[simp] theorem exchangeArgs_exchange (p q : FName) {n ms} (args : Arg signature n ms) :
    exchangeArgs p q (exchangeArgs p q args) = args := by
  match args with
  | .nil => rfl
  | .cons t rest =>
      change Arg.cons (exchange p q (exchange p q t))
        (exchangeArgs p q (exchangeArgs p q rest)) = Arg.cons t rest
      rw [exchange_exchange, exchangeArgs_exchange]
termination_by structural args
end

-- Formation transport is shared by typing, finality and auxiliary unravelling.
mutual
theorem IsValue.exchange {p q U U' n} {v : RawTerm n} (hv : IsValue U v)
    (h : ∀ r, r ∈ U → p.exchange q r ∈ U') : IsValue U' (exchange p q v) := by
  match hv with
  | .integer z => exact .integer z
  | .boolean b => exact .boolean b
  | .unit => exact .unit
  | .identifier i => exact .identifier i
  | .future hr => exact .future (h _ hr)
  | .funE first rest result hb => exact .funE first rest result (hb.exchange h)
  | .fixE first rest result hb => exact .fixE first rest result (hb.exchange h)
  | .sexp_int ha => exact .sexp_int (ha.exchange h)
  | .sexp_bool ha => exact .sexp_bool (ha.exchange h)
  | .sexp_id ha => exact .sexp_id (ha.exchange h)
  | .nil => exact .nil
  | .pair ha hb => exact .pair (ha.exchange h) (hb.exchange h)
termination_by structural hv

theorem IsAtom.exchange {p q U U' n} {a : RawTerm n} (ha : IsAtom U a)
    (h : ∀ r, r ∈ U → p.exchange q r ∈ U') : IsAtom U' (exchange p q a) := by
  match ha with
  | .bound i => exact .bound i
  | .free x => exact .free x
  | .value hv => exact .value (hv.exchange h)
termination_by structural ha

theorem IsTerm.exchange {p q U U' n} {t : RawTerm n} (ht : IsTerm U t)
    (h : ∀ r, r ∈ U → p.exchange q r ∈ U') : IsTerm U' (exchange p q t) := by
  match ht with
  | .atom ha => exact .atom (ha.exchange h)
  | .app hf ha hs => exact .app (hf.exchange h) (ha.exchange h) (hs.exchange h)
  | .operation op ha hb => exact .operation op (ha.exchange h) (hb.exchange h)
  | .ifE hg hy hn => exact .ifE (hg.exchange h) (hy.exchange h) (hn.exchange h)
  | .letE hr hb => exact .letE (hr.exchange h) (hb.exchange h)
  | .matchE ha hs hf => exact .matchE (ha.exchange h) (hs.exchange h) hf
  | .async hb => exact .async (hb.exchange h)
termination_by structural ht

theorem IsBranch.exchange {p q U U' n pat} {b : RawTerm n} (hb : IsBranch U pat b)
    (h : ∀ r, r ∈ U → p.exchange q r ∈ U') : IsBranch U' pat (exchange p q b) := by
  match hb with
  | .branch ht => exact .branch (ht.exchange h)
termination_by structural hb

theorem IsBranches.exchange {p q U U' n ps ms} {bs : Arg signature n ms} (hs : IsBranches U ps bs)
    (h : ∀ r, r ∈ U → p.exchange q r ∈ U') : IsBranches U' ps (exchangeArgs p q bs) := by
  match hs with
  | .nil => exact .nil
  | .cons hb hs => exact .cons (hb.exchange h) (hs.exchange h)
termination_by structural hs

theorem IsAtoms.exchange {p q U U' n ms} {args : Arg signature n ms} (hs : IsAtoms U args)
    (h : ∀ r, r ∈ U → p.exchange q r ∈ U') : IsAtoms U' (exchangeArgs p q args) := by
  match hs with
  | .nil => exact .nil
  | .cons ha hs => exact .cons (ha.exchange h) (hs.exchange h)
termination_by structural hs
end

private theorem exchange_domain {p q : FName} {sig sig' : Signature}
    (h : ∀ r, sig'[p.exchange q r]? = sig[r]?) :
    ∀ r, r ∈ domain sig → p.exchange q r ∈ domain sig' := by
  intro r hr
  exact mem_domain_of_lookup ((h r).trans (Std.ExtTreeMap.getElem?_eq_some_getElem (mem_domain.mp hr)))

mutual
theorem Typing.exchange {p q sig sig' Γ n Δ t A} (ht : Typing sig Γ (n := n) Δ t A)
    (h : ∀ r, sig'[p.exchange q r]? = sig[r]?) : Typing sig' Γ Δ (exchange p q t) A := by
  match ht with
  | .bound i => exact .bound i
  | .free hx => exact .free hx
  | .future hr => exact .future ((h _).trans hr)
  | .integer z => exact .integer z
  | .boolean b => exact .boolean b
  | .unit => exact .unit
  | .identifier i => exact .identifier i
  | .funE hb => exact .funE (hb.exchange h)
  | .fixE hb => exact .fixE (hb.exchange h)
  | .sexp_int ha ht => exact .sexp_int (ha.exchange (exchange_domain h)) (ht.exchange h)
  | .sexp_bool ha ht => exact .sexp_bool (ha.exchange (exchange_domain h)) (ht.exchange h)
  | .sexp_id ha ht => exact .sexp_id (ha.exchange (exchange_domain h)) (ht.exchange h)
  | .nil => exact .nil
  | .pair ha hb ht hu =>
      exact .pair (ha.exchange (exchange_domain h)) (hb.exchange (exchange_domain h))
        (ht.exchange h) (hu.exchange h)
  | .app hf ha ht hu hs =>
      exact .app (hf.exchange (exchange_domain h)) (ha.exchange (exchange_domain h))
        (ht.exchange h) (hu.exchange h) (hs.exchange h)
  | .arith hop ha hb ht hu =>
      exact .arith hop (ha.exchange (exchange_domain h)) (hb.exchange (exchange_domain h))
        (ht.exchange h) (hu.exchange h)
  | .eq hA ha hb ht hu =>
      exact .eq hA (ha.exchange (exchange_domain h)) (hb.exchange (exchange_domain h))
        (ht.exchange h) (hu.exchange h)
  | .lt ha hb ht hu =>
      exact .lt (ha.exchange (exchange_domain h)) (hb.exchange (exchange_domain h))
        (ht.exchange h) (hu.exchange h)
  | .ifE hg ht hy hn => exact .ifE (hg.exchange (exchange_domain h)) (ht.exchange h) (hy.exchange h) (hn.exchange h)
  | .letE hr hb => exact .letE (hr.exchange h) (hb.exchange h)
  | .matchE ha ht hs hf => exact .matchE (ha.exchange (exchange_domain h)) (ht.exchange h) (hs.exchange h) hf
  | .async hb => exact .async (hb.exchange h)
termination_by structural ht

theorem BranchTyping.exchange {p q sig sig' Γ n Δ pat b A} (ht : BranchTyping sig Γ (n := n) Δ pat b A)
    (h : ∀ r, sig'[p.exchange q r]? = sig[r]?) : BranchTyping sig' Γ Δ pat (exchange p q b) A := by
  match ht with
  | .int hb => exact .int (hb.exchange h)
  | .bool hb => exact .bool (hb.exchange h)
  | .id hb => exact .id (hb.exchange h)
  | .nil hb => exact .nil (hb.exchange h)
  | .pair hb => exact .pair (hb.exchange h)
  | .wildcard hb => exact .wildcard (hb.exchange h)
termination_by structural ht

theorem ArgsTyping.exchange {p q sig sig' Γ n Δ As ms args} (ht : ArgsTyping sig Γ (n := n) Δ As (ms := ms) args)
    (h : ∀ r, sig'[p.exchange q r]? = sig[r]?) : ArgsTyping sig' Γ Δ As (exchangeArgs p q args) := by
  match ht with
  | .nil => exact .nil
  | .cons ha ht hs => exact .cons (ha.exchange (exchange_domain h)) (ht.exchange h) (hs.exchange h)
termination_by structural ht

theorem BranchesTyping.exchange {p q sig sig' Γ n Δ ps ms bs A} (ht : BranchesTyping sig Γ (n := n) Δ ps (ms := ms) bs A)
    (h : ∀ r, sig'[p.exchange q r]? = sig[r]?) : BranchesTyping sig' Γ Δ ps (exchangeArgs p q bs) A := by
  match ht with
  | .nil => exact .nil
  | .cons hb hs => exact .cons (hb.exchange h) (hs.exchange h)
termination_by structural ht
end

/-- Consistent exchange of signature keys, focus, mapping keys and mapped terms.
    The equations also preserve undefined lookups. Both endpoints use the formed carrier. -/
structure State.Exchange (p q : FName) (s t : State) : Prop where
  signature : ∀ r, t.signature[p.exchange q r]? = s.signature[r]?
  focus : t.focus = exchange p q s.focus
  mapping : ∀ r, t.mapping[p.exchange q r]? = (s.mapping[r]?).map (exchange p q)

theorem State.Exchange.symm {p q s t} (h : State.Exchange p q s t) : State.Exchange p q t s := by
  refine ⟨?_, ?_, ?_⟩
  · intro r
    simpa only [FName.exchange_exchange] using (h.signature (p.exchange q r)).symm
  · rw [h.focus, exchange_exchange]
  · intro r
    have hm := congrArg (Option.map (exchange p q)) (h.mapping (p.exchange q r))
    simpa [Option.map_map, Function.comp_def] using hm.symm

private theorem State.Exchange.signature_domain {p q s t} (h : State.Exchange p q s t) (r : FName) :
    p.exchange q r ∈ domain t.signature ↔ r ∈ domain s.signature := by
  simp only [mem_domain, Std.ExtTreeMap.mem_iff_isSome_getElem?, h.signature]

private theorem State.Exchange.mapping_domain {p q s t} (h : State.Exchange p q s t) (r : FName) :
    p.exchange q r ∈ domain t.mapping ↔ r ∈ domain s.mapping := by
  simp only [mem_domain, Std.ExtTreeMap.mem_iff_isSome_getElem?, h.mapping, Option.isSome_map]

private theorem State.Exchange.entry {p q s t r body} (h : State.Exchange p q s t)
    (hb : t.mapping[r]? = some body) :
    ∃ old, s.mapping[p.exchange q r]? = some old ∧ exchange p q old = body := by
  have hm := h.mapping (p.exchange q r)
  rw [FName.exchange_exchange, hb] at hm
  exact Option.map_eq_some_iff.mp hm.symm

/-- The Ok clause needed by O-Alpha; no reduction compatibility is assumed. -/
theorem State.Exchange.ok {p q s t} (h : State.Exchange p q s t) (hs : s.Ok) : t.Ok := by
  obtain ⟨A, ht⟩ := hs.focus
  refine ⟨?_, ⟨A, ?_⟩, ?_⟩
  · apply Std.ExtTreeSet.ext_mem
    intro r
    calc
      r ∈ domain t.mapping ↔ p.exchange q r ∈ domain s.mapping := by
        simpa only [FName.exchange_exchange] using h.mapping_domain (p.exchange q r)
      _ ↔ p.exchange q r ∈ domain s.signature := by rw [hs.domains]
      _ ↔ r ∈ domain t.signature := by
        simpa only [FName.exchange_exchange] using (h.signature_domain (p.exchange q r)).symm
  · rw [h.focus]
    exact ht.exchange h.signature
  · intro r body B hm hB
    obtain ⟨old, hold, rfl⟩ := h.entry hm
    have hB' : s.signature[p.exchange q r]? = some B := by
      have he := h.signature (p.exchange q r)
      rw [FName.exchange_exchange] at he
      exact he.symm.trans hB
    exact (hs.entries _ _ _ hold hB').exchange h.signature

theorem State.Exchange.final {p q s t} (h : State.Exchange p q s t) (hs : s.Final) : t.Final := by
  refine ⟨?_, ?_⟩
  · rw [h.focus]
    exact hs.focus.exchange (exchange_domain h.signature)
  · intro r body hm
    obtain ⟨old, hold, rfl⟩ := h.entry hm
    exact (hs.entries _ _ hold).exchange (exchange_domain h.signature)

theorem Unravelling.exchange {p q mu mu' w v} (h : Unravelling mu w v)
    (hm : ∀ r, mu'[p.exchange q r]? = (mu[r]?).map (exchange p q)) :
    Unravelling mu' (exchange p q w) v := by
  induction h with
  | integer z => exact .integer z
  | true => exact .true
  | false => exact .false
  | unit => exact .unit
  | identifier i => exact .identifier i
  | future hr _ ih => exact .future (by rw [hm, hr]; rfl) ih
  | sexp_int _ ih => exact .sexp_int ih
  | sexp_bool _ ih => exact .sexp_bool ih
  | sexp_id _ ih => exact .sexp_id ih
  | nil => exact .nil
  | pair _ _ ih₁ ih₂ => exact .pair ih₁ ih₂

theorem State.Exchange.observes {p q s t v} (h : State.Exchange p q s t)
    (hs : s.Observes v) : t.Observes v := by
  have hf := h.final hs.final
  refine ⟨h.ok hs.ok, hf, ⟨⟨domain t.signature, t.domains, hf.focus, t.entries_formed⟩,
    hs.unravels.value, ?_⟩⟩
  rw [h.focus]
  exact hs.unravels.derivation.exchange h.mapping

/-- Runtime §3: the least equivalence generated by consistent fresh renamings.
    The old name must be declared and its replacement fresh for the whole signature. -/
inductive State.Alpha : State → State → Prop where
  | rename {s t : State} {p q : FName} :
      p ∈ domain s.signature → q ∉ domain s.signature → State.Exchange p q s t → Alpha s t
  | refl (s : State) : Alpha s s
  | symm {s t} : Alpha s t → Alpha t s
  | trans {s t u} : Alpha s t → Alpha t u → Alpha s u

/-- O-Alpha: consistent future renaming preserves the identical source observation. -/
theorem State.Alpha.observes_iff {s t : State} (h : s.Alpha t) {v} :
    s.Observes v ↔ t.Observes v := by
  induction h with
  | rename _ _ he => exact ⟨he.observes, he.symm.observes⟩
  | refl => exact Iff.rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

private theorem name_exchange_inj {p q a b : FName} : p.exchange q a = p.exchange q b ↔ a = b :=
  ⟨fun h => by simpa using congrArg (p.exchange q) h, congrArg (p.exchange q)⟩

private theorem name_exchange_left (p q : FName) : p.exchange q p = q := by
  simp [FName.exchange, swap]

private theorem name_exchange_right (p q : FName) : p.exchange q q = p := by
  by_cases h : p = q
  · subst q; exact name_exchange_left p p
  · cases p; cases q; simp_all [FName.exchange, swap, FName.mk.injEq]

-- alter handles absent keys as well as declared keys; map transforms stored values.
private def exchangeMap {α : Type} (p q : FName) (f : α → α) (mu : FMap α) : FMap α :=
  ((mu.alter p (fun _ => mu[q]?)).alter q (fun _ => mu[p]?)).map (fun _ => f)

private theorem exchangeMap_lookup {α : Type} (p q r : FName) (f : α → α) (mu : FMap α) :
    (exchangeMap p q f mu)[p.exchange q r]? = (mu[r]?).map f := by
  by_cases hp : r = p
  · subst r
    simp [exchangeMap, name_exchange_left, Std.ExtTreeMap.getElem?_map]
  · by_cases hq : r = q
    · subst r
      rw [name_exchange_right]
      simp [exchangeMap, Std.ExtTreeMap.getElem?_map, Std.ExtTreeMap.getElem?_alter,
        Std.LawfulEqCmp.compare_eq_iff_eq, hp]
    · have e : p.exchange q r = r := by
        cases p; cases q; cases r; simp_all [FName.exchange, swap, FName.mk.injEq, eq_comm]
      simp [exchangeMap, e, Std.ExtTreeMap.getElem?_map, Std.ExtTreeMap.getElem?_alter,
        Std.LawfulEqCmp.compare_eq_iff_eq, Ne.symm hp, Ne.symm hq]

private theorem exchangeMap_insert {α : Type} (p q r : FName) (f : α → α) (mu : FMap α) (v : α) :
    exchangeMap p q f (mu.insert r v) = (exchangeMap p q f mu).insert (p.exchange q r) (f v) := by
  apply Std.ExtTreeMap.ext_getElem?
  intro a
  have eqn := FName.exchange_exchange p q a
  conv => lhs; rw [← eqn]
  rw [exchangeMap_lookup]
  conv => rhs; rw [← eqn]
  simp only [Std.ExtTreeMap.getElem?_insert, Std.LawfulEqCmp.compare_eq_iff_eq,
    name_exchange_inj, exchangeMap_lookup]
  split <;> rfl

private theorem exchanged_domain {α : Type} (p q r : FName) (f : α → α) (mu : FMap α) :
    p.exchange q r ∈ domain (exchangeMap p q f mu) ↔ r ∈ domain mu := by
  simp only [mem_domain, Std.ExtTreeMap.mem_iff_isSome_getElem?, exchangeMap_lookup, Option.isSome_map]

mutual
private theorem exchange_weaken (p q : FName) {m n} (t : RawTerm m) (h : m ≤ n) :
    exchange p q (t.weaken n h) = (exchange p q t).weaken n h := by
  match t with
  | .var _ | .atom _ | .op (.future _) .nil => rfl
  | .op (.source o) args => exact congrArg (Trm.op (Sg := signature) (.source o)) (exchangeArgs_weaken p q args h)
termination_by structural t

private theorem exchangeArgs_weaken (p q : FName) {m n ms} (args : Arg signature m ms) (h : m ≤ n) :
    exchangeArgs p q (args.weaken n h) = (exchangeArgs p q args).weaken n h := by
  match args with
  | .nil => rfl
  | .cons t rest =>
      change Arg.cons (exchange p q (t.weaken _ _)) (exchangeArgs p q (rest.weaken n h)) = _
      rw [exchange_weaken, exchangeArgs_weaken]; rfl
termination_by structural args
end

mutual
private theorem exchange_open (p q : FName) {m n} (t : RawTerm m) (i : Fin m) (a : RawTerm 0)
    (e : m = n + 1) : exchange p q (opn i a t e) = opn i (exchange p q a) (exchange p q t) e := by
  match t with
  | .var j =>
      by_cases h : i = j
      · subst j; simp only [opn_var_eq, exchange, exchange_weaken]
      · simp only [opn_var_ne a e h, exchange, opn_var_ne (exchange p q a) e h]
  | .atom _ | .op (.future _) .nil => rfl
  | .op (.source o) args => exact congrArg (Trm.op (Sg := signature) (.source o)) (exchangeArgs_open p q args i a e)
termination_by structural t

private theorem exchangeArgs_open (p q : FName) {m n ms} (args : Arg signature m ms)
    (i : Fin m) (a : RawTerm 0) (e : m = n + 1) :
    exchangeArgs p q (opnArg i a args e) = opnArg i (exchange p q a) (exchangeArgs p q args) e := by
  match args with
  | .nil => rfl
  | .cons t rest =>
      change Arg.cons (exchange p q (opn _ a t _)) (exchangeArgs p q (opnArg i a rest e)) = _
      rw [exchange_open, exchangeArgs_open]; rfl
termination_by structural args
end

private theorem exchange_conc (p q : FName) {n} (body : RawTerm (n + 1)) (a : RawTerm 0) :
    exchange p q (body.conc a) = (exchange p q body).conc (exchange p q a) := exchange_open p q body _ a rfl

private theorem exchange_castScope (p q : FName) {m n} (t : RawTerm m) (e : m = n) :
    exchange p q (t.castScope e) = (exchange p q t).castScope e := by cases e; rfl

private theorem exchange_instantiate (p q : FName) (args : List (RawTerm 0)) (body : RawTerm args.length) :
    exchange p q (instantiate args body) = instantiate (args.map (exchange p q))
      ((exchange p q body).castScope (by simp)) := by
  induction args with
  | nil => rfl
  | cons a rest ih =>
      simp only [instantiate, List.map_cons]
      rw [ih, exchange_conc]
      have cast_conc {m n} (e : m = n) (b : RawTerm (m + 1)) (v : RawTerm 0) :
          (b.castScope (congrArg (· + 1) e)).conc v = (b.conc v).castScope e := by cases e; rfl
      rw [cast_conc]

private theorem exchange_app (p q : FName) (fn first : RawTerm 0) (rest : List (RawTerm 0)) :
    exchange p q (app fn first (toArgs rest)) =
      app (exchange p q fn) (exchange p q first) (toArgs (rest.map (exchange p q))) := by
  have cons_heq {ms ns} (e : ms = ns) (t : RawTerm 0)
      (as : Arg signature 0 ms) (bs : Arg signature 0 ns) (h : HEq as bs) :
      HEq (Arg.cons (m := 0) t as) (Arg.cons (m := 0) t bs) := by cases e; cases h; rfl
  have args : HEq (exchangeArgs p q (toArgs rest)) (toArgs (rest.map (exchange p q))) := by
    induction rest with
    | nil => rfl
    | cons a rest ih => exact cons_heq (by simp) (exchange p q a) _ _ ih
  have h := cons_heq (by simp) (exchange p q fn) _ _
    (cons_heq (by simp) (exchange p q first) _ _ args)
  have op_eq {o o' : Op} (e : o = o') (as : Arg signature 0 (signature.ar o))
      (bs : Arg signature 0 (signature.ar o')) (he : HEq as bs) :
      Trm.op (Sg := signature) o as = Trm.op o' bs := by cases e; cases he; rfl
  exact op_eq (by simp) _ _ h

private theorem ArgMember.exchange {p q a ms bs} (h : ArgMember a (ms := ms) bs) :
    ArgMember (Runtime.exchange p q a) (exchangeArgs p q bs) := by
  induction h with
  | here => exact .here
  | there _ ih => exact .there ih

private theorem MatchBranch.exchange {p q U V v b r} (h : MatchBranch U v b r)
    (domains : ∀ a, a ∈ U → p.exchange q a ∈ V) :
    MatchBranch V (Runtime.exchange p q v) (Runtime.exchange p q b) (Runtime.exchange p q r) := by
  cases h with
  | int ha => rw [exchange_conc]; exact .int (ha.exchange domains)
  | bool ha => rw [exchange_conc]; exact .bool (ha.exchange domains)
  | id ha => rw [exchange_conc]; exact .id (ha.exchange domains)
  | nil => exact .nil
  | pair ha hb => rw [exchange_conc, exchange_conc]; exact .pair (ha.exchange domains) (hb.exchange domains)

private theorem constructorHead_exchange (p q : FName) {n} (v : RawTerm n) :
    constructorHead (exchange p q v) = constructorHead v := by
  cases v with
  | var | atom => rfl
  | op o args => cases o with
    | future => cases args; rfl
    | source o => cases o <;> rfl

-- The existential tested by Spawn-App is invariant; Search-Let uses its negation.
private theorem pending_exchange {p q : FName} {sig sig' : Signature} {mu mu' : Mapping}
    {k : Nat} {fn first : RawTerm 0} {rest : RawArgs 0 k}
    (hs : ∀ r, sig'[p.exchange q r]? = sig[r]?)
    (hm : ∀ r, mu'[p.exchange q r]? = (mu[r]?).map (exchange p q))
    (h : ∃ (r : FName) (body : RawTerm 0),
      (fn = future r ∨ first = future r ∨ ArgMember (future r) rest) ∧
      mu[r]? = some body ∧ ¬ IsValue (domain sig) body) :
    ∃ (r : FName) (body : RawTerm 0),
      (exchange p q fn = future r ∨ exchange p q first = future r ∨ ArgMember (future r) (exchangeArgs p q rest)) ∧
      mu'[r]? = some body ∧ ¬ IsValue (domain sig') body := by
  obtain ⟨r, body, pos, lookup, pending⟩ := h
  refine ⟨p.exchange q r, exchange p q body, ?_, by rw [hm, lookup]; rfl, ?_⟩
  · rcases pos with rfl | rfl | member
    · exact Or.inl rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr member.exchange)
  · intro hv
    apply pending
    have back : ∀ r, sig[p.exchange q r]? = sig'[r]? := by
      intro r; simpa only [FName.exchange_exchange] using (hs (p.exchange q r)).symm
    simpa only [exchange_exchange] using hv.exchange (exchange_domain back)

private theorem LocalStep.exchange_rule {sig mu t sig' mu' t'} (h : LocalStep sig mu t sig' mu' t')
    (p q : FName) :
    LocalStep (exchangeMap p q id sig) (exchangeMap p q (exchange p q) mu) (exchange p q t)
      (exchangeMap p q id sig') (exchangeMap p q (exchange p q) mu') (exchange p q t') := by
  have domains := fun r => (exchanged_domain p q r id sig).mpr
  have hs : ∀ r, (exchangeMap p q id sig)[p.exchange q r]? = sig[r]? := by
    intro r; simpa using exchangeMap_lookup p q r id sig
  have hm := fun r => exchangeMap_lookup p q r (exchange p q) mu
  induction h with
  | search_let absent rule hb ih =>
      apply LocalStep.search_let _ ih (hb.exchange domains)
      rintro ⟨k, fn, first, rest, r, body, eqn, pos, lookup, pending⟩
      have hsBack : ∀ r, sig[p.exchange q r]? = (exchangeMap p q id sig)[r]? := by
        intro r; simpa only [FName.exchange_exchange] using (hs (p.exchange q r)).symm
      have hmBack : ∀ r, mu[p.exchange q r]? = ((exchangeMap p q (exchange p q) mu)[r]?).map (exchange p q) := by
        intro r
        have e := congrArg (Option.map (exchange p q)) (hm (p.exchange q r))
        simpa [Option.map_map, Function.comp_def] using e.symm
      have hp := pending_exchange hsBack hmBack ⟨r, body, pos, lookup, pending⟩
      have eqn' := congrArg (exchange p q) eqn
      simp only [exchange_exchange] at eqn'
      obtain ⟨r', body', pos', lookup', pending'⟩ := hp
      exact absent ⟨k, exchange p q fn, exchange p q first, exchangeArgs p q rest, r', body',
        eqn', pos', lookup', pending'⟩
  | @beta A As B body v vs arity hb hv hvs =>
      rw [exchange_app, exchange_instantiate]
      simp only [List.map_cons, exchange_castScope, castScope_trans]
      exact .beta (vs := vs.map (exchange p q)) (by simpa using arity) (hb.exchange domains) (hv.exchange domains) (by
        intro a ha; obtain ⟨b, hb, rfl⟩ := List.mem_map.mp ha; exact (hvs b hb).exchange domains)
  | @fix_beta A As B body v vs arity hb hv hvs =>
      rw [exchange_app, exchange_instantiate]
      simp only [List.map_cons, exchange_castScope, castScope_trans]
      exact .fix_beta (vs := vs.map (exchange p q)) (by simpa using arity) (hb.exchange domains) (hv.exchange domains) (by
        intro a ha; obtain ⟨b, hb, rfl⟩ := List.mem_map.mp ha; exact (hvs b hb).exchange domains)
  | let_value hv hb => rw [exchange_conc]; exact .let_value (hv.exchange domains) (hb.exchange domains)
  | match_constructor hb hp member matched =>
      exact .match_constructor (hb.exchange domains) hp member.exchange (matched.exchange domains)
  | match_wildcard hv head absent hb hp member =>
      exact .match_wildcard (hv.exchange domains) ((constructorHead_exchange p q _).trans head)
        absent (hb.exchange domains) hp member.exchange
  | add m n => exact .add m n
  | sub m n => exact .sub m n
  | mul m n => exact .mul m n
  | eq_int_true e => exact .eq_int_true e
  | eq_int_false e => exact .eq_int_false e
  | eq_id_true e => exact .eq_id_true e
  | eq_id_false e => exact .eq_id_false e
  | lt_true e => exact .lt_true e
  | lt_false e => exact .lt_false e
  | if_true hy hn => exact .if_true (hy.exchange domains) (hn.exchange domains)
  | if_false hy hn => exact .if_false (hy.exchange domains) (hn.exchange domains)
  | spawn_async ht fresh =>
      rw [exchangeMap_insert, exchangeMap_insert]
      exact .spawn_async (ht.exchange hs) (fun hr => fresh ((exchanged_domain p q _ id sig).mp hr))
  | deref_app lookup hv => exact .deref_app (by rw [hm, lookup]; rfl) (hv.exchange domains)
  | deref_op_left lookup hv => exact .deref_op_left (by rw [hm, lookup]; rfl) (hv.exchange domains)
  | deref_op_right lookup hv => exact .deref_op_right (by rw [hm, lookup]; rfl) (hv.exchange domains)
  | deref_if lookup hv => exact .deref_if (by rw [hm, lookup]; rfl) (hv.exchange domains)
  | deref_match lookup hv => exact .deref_match (by rw [hm, lookup]; rfl) (hv.exchange domains)
  | spawn_app hp ht fresh hb =>
      rw [exchangeMap_insert, exchangeMap_insert]
      exact .spawn_app (pending_exchange hs hm hp) (ht.exchange hs)
        (fun hr => fresh ((exchanged_domain p q _ id sig).mp hr)) (hb.exchange domains)

private def exchangedState (p q : FName) (s : State) : State where
  signature := exchangeMap p q id s.signature
  focus := exchange p q s.focus
  mapping := exchangeMap p q (exchange p q) s.mapping
  domains := by
    intro r hr
    have hm : p.exchange q r ∈ domain s.mapping := by
      apply (exchanged_domain p q (p.exchange q r) (exchange p q) s.mapping).mp
      simpa only [FName.exchange_exchange] using hr
    have hs := (exchanged_domain p q (p.exchange q r) id s.signature).mpr (s.domains _ hm)
    simpa only [FName.exchange_exchange] using hs
  focus_formed := s.focus_formed.exchange (fun r => (exchanged_domain p q r id s.signature).mpr)
  entries_formed := by
    intro r body hr
    have e := exchangeMap_lookup p q (p.exchange q r) (exchange p q) s.mapping
    rw [FName.exchange_exchange, hr] at e
    obtain ⟨old, hold, rfl⟩ := Option.map_eq_some_iff.mp e.symm
    exact (s.entries_formed _ _ hold).exchange (fun r => (exchanged_domain p q r id s.signature).mpr)

private theorem exchangedState_spec (p q : FName) (s : State) : State.Exchange p q s (exchangedState p q s) := by
  refine ⟨?_, rfl, ?_⟩
  · intro r; simpa [exchangedState] using exchangeMap_lookup p q r id s.signature
  · exact fun r => exchangeMap_lookup p q r (exchange p q) s.mapping

private theorem state_eq {s t : State} (hs : s.signature = t.signature)
    (hf : s.focus = t.focus) (hm : s.mapping = t.mapping) : s = t := by
  cases s; cases t; cases hs; cases hf; cases hm; rfl

private theorem State.Exchange.unique {p q s t u} (h : State.Exchange p q s t)
    (h' : State.Exchange p q s u) : t = u := by
  refine state_eq ?_ (h.focus.trans h'.focus.symm) ?_
  · apply Std.ExtTreeMap.ext_getElem?
    intro r
    simpa only [FName.exchange_exchange] using (h.signature (p.exchange q r)).trans (h'.signature (p.exchange q r)).symm
  · apply Std.ExtTreeMap.ext_getElem?
    intro r
    simpa only [FName.exchange_exchange] using (h.mapping (p.exchange q r)).trans (h'.mapping (p.exchange q r)).symm

/-- Transport a whole local derivation by the same exchange, including allocated names. -/
theorem State.Exchange.local_step {p q s u t} (h : State.Exchange p q s u) (step : s.LocalStep t) :
    ∃ v, u.LocalStep v ∧ State.Exchange p q t v := by
  have e := h.unique (exchangedState_spec p q s)
  subst u
  exact ⟨exchangedState p q t, step.exchange_rule p q, exchangedState_spec p q t⟩

private theorem Step.exchange_state {s t : State} (step : Step s t) (p q : FName) :
    Step (exchangedState p q s) (exchangedState p q t) := by
  cases step with
  | focus rule => exact .focus (rule.exchange_rule p q)
  | @future mid t r body hr rule es ef em =>
      have hr' : (exchangedState p q s).mapping[p.exchange q r]? = some (exchange p q body) := by
        change (exchangeMap p q (exchange p q) s.mapping)[p.exchange q r]? = _
        rw [exchangeMap_lookup, hr]; rfl
      apply Step.future (t := exchangedState p q mid) hr' (rule.exchange_rule p q)
      · exact congrArg (exchangeMap p q id) es
      · exact congrArg (exchange p q) ef
      · change exchangeMap p q (exchange p q) t.mapping = _
        rw [em, exchangeMap_insert]; rfl

/-- Interleave-Future transports both the selected key and the returned mapping update. -/
theorem State.Exchange.step {p q s u t} (h : State.Exchange p q s u) (step : Step s t) :
    ∃ v, Step u v ∧ State.Exchange p q t v := by
  have e := h.unique (exchangedState_spec p q s)
  subst u
  exact ⟨exchangedState p q t, step.exchange_state p q, exchangedState_spec p q t⟩

private theorem name_exchange_other {p q r : FName} (hp : p ≠ r) (hq : q ≠ r) : p.exchange q r = r := by
  cases p; cases q; cases r; simp_all [FName.exchange, swap, FName.mk.injEq]

-- Formed syntax uses only the declared names, so an exchange fixing those names
-- fixes the whole phrase, including function and branch bodies.
mutual
private theorem IsValue.exchange_fixed {p q U n t} (h : IsValue U (n := n) t)
    (fixed : ∀ r, r ∈ U → p.exchange q r = r) : exchange p q t = t := by
  match h with
  | .integer _ | .boolean _ | .unit | .identifier _ | .nil => rfl
  | .future hr => exact congrArg future (fixed _ hr)
  | .funE A As B hb => exact congrArg (funE A As B) (hb.exchange_fixed fixed)
  | .fixE A As B hb => exact congrArg (fixE A As B) (hb.exchange_fixed fixed)
  | .sexp_int ha => exact congrArg sexp_int (ha.exchange_fixed fixed)
  | .sexp_bool ha => exact congrArg sexp_bool (ha.exchange_fixed fixed)
  | .sexp_id ha => exact congrArg sexp_id (ha.exchange_fixed fixed)
  | .pair ha hb => change pair _ _ = _; rw [ha.exchange_fixed fixed, hb.exchange_fixed fixed]
termination_by structural h

private theorem IsAtom.exchange_fixed {p q U n t} (h : IsAtom U (n := n) t)
    (fixed : ∀ r, r ∈ U → p.exchange q r = r) : exchange p q t = t := by
  match h with
  | .bound _ | .free _ => rfl
  | .value hv => exact hv.exchange_fixed fixed
termination_by structural h

private theorem IsTerm.exchange_fixed {p q U n t} (h : IsTerm U (n := n) t)
    (fixed : ∀ r, r ∈ U → p.exchange q r = r) : exchange p q t = t := by
  match h with
  | .atom ha => exact ha.exchange_fixed fixed
  | .app hf ha hs => change app _ _ _ = _; rw [hf.exchange_fixed fixed, ha.exchange_fixed fixed, hs.exchange_fixed fixed]
  | .operation op ha hb => change operation op _ _ = _; rw [ha.exchange_fixed fixed, hb.exchange_fixed fixed]
  | .ifE hg hy hn => change ifE _ _ _ = _; rw [hg.exchange_fixed fixed, hy.exchange_fixed fixed, hn.exchange_fixed fixed]
  | .letE hr hb => change letE _ _ = _; rw [hr.exchange_fixed fixed, hb.exchange_fixed fixed]
  | .async hb => exact congrArg async (hb.exchange_fixed fixed)
  | .matchE ha hs _ => change matchE _ _ = _; rw [ha.exchange_fixed fixed, hs.exchange_fixed fixed]
termination_by structural h

private theorem IsBranch.exchange_fixed {p q U n pat t} (h : IsBranch U pat (n := n) t)
    (fixed : ∀ r, r ∈ U → p.exchange q r = r) : exchange p q t = t := by
  match h with
  | .branch hb => exact congrArg (branch pat) (hb.exchange_fixed fixed)
termination_by structural h

private theorem IsBranches.exchange_fixed {p q U n ps ms ts} (h : IsBranches U ps (n := n) (ms := ms) ts)
    (fixed : ∀ r, r ∈ U → p.exchange q r = r) : exchangeArgs p q ts = ts := by
  match h with
  | .nil => rfl
  | .cons hb hs => change Arg.cons _ _ = _; rw [hb.exchange_fixed fixed, hs.exchange_fixed fixed]
termination_by structural h

private theorem IsAtoms.exchange_fixed {p q U n ms ts} (h : IsAtoms U (n := n) (ms := ms) ts)
    (fixed : ∀ r, r ∈ U → p.exchange q r = r) : exchangeArgs p q ts = ts := by
  match h with
  | .nil => rfl
  | .cons ha hs => change Arg.cons _ _ = _; rw [ha.exchange_fixed fixed, hs.exchange_fixed fixed]
termination_by structural h
end

private theorem map_fixed_lookup {α : Type} (p q : FName) (f : α → α) (mu : FMap α)
    (keys : ∀ r, r ∈ domain mu → p.exchange q r = r)
    (values : ∀ (r : FName) v, mu[r]? = some v → f v = v) (r : FName) :
    mu[p.exchange q r]? = (mu[r]?).map f := by
  cases hr : mu[r]? with
  | some v => rw [keys r (mem_domain_of_lookup hr), hr, Option.map_some, values r v hr]
  | none =>
      have absent : p.exchange q r ∉ domain mu := by
        intro hm
        have e := keys _ hm
        rw [FName.exchange_exchange] at e
        rw [← e] at hm
        have hs := Std.ExtTreeMap.getElem?_eq_some_getElem (mem_domain.mp hm)
        rw [hr] at hs; cases hs
      rw [Std.ExtTreeMap.getElem?_eq_none (by simpa only [mem_domain] using absent)]
      rfl

private theorem State.Exchange.fixed {p q s t} (h : State.Exchange p q s t)
    (keys : ∀ r, r ∈ domain s.signature → p.exchange q r = r) : s = t := by
  have self : State.Exchange p q s s := ⟨
    by intro r; simpa using map_fixed_lookup p q id s.signature keys (by intros; rfl) r,
    (s.focus_formed.exchange_fixed keys).symm,
    map_fixed_lookup p q (exchange p q) s.mapping (fun r hr => keys r (s.domains r hr))
      (fun r body hr => (s.entries_formed r body hr).exchange_fixed keys)⟩
  exact self.unique h

private theorem name_exchange_three (p q r a : FName) (hpq : p ≠ q) (hpr : p ≠ r) (hqr : q ≠ r) :
    r.exchange q (q.exchange p (p.exchange r a)) = p.exchange q a := by
  cases p with | mk p =>
    cases q with | mk q =>
      cases r with | mk r =>
        cases a with | mk a =>
          by_cases ha : a = p <;> by_cases hb : a = q <;> by_cases hc : a = r <;>
            simp_all [FName.exchange, swap, FName.mk.injEq, eq_comm]

mutual
private theorem exchange_three (p q r : FName) (hpq : p ≠ q) (hpr : p ≠ r) (hqr : q ≠ r)
    {n} (t : RawTerm n) : exchange r q (exchange q p (exchange p r t)) = exchange p q t := by
  match t with
  | .var _ | .atom _ => rfl
  | .op (.future a) .nil => exact congrArg future (name_exchange_three p q r a hpq hpr hqr)
  | .op (.source o) args =>
      exact congrArg (Trm.op (Sg := signature) (.source o)) (exchangeArgs_three p q r hpq hpr hqr args)
termination_by structural t

private theorem exchangeArgs_three (p q r : FName) (hpq : p ≠ q) (hpr : p ≠ r) (hqr : q ≠ r)
    {n ms} (args : Arg signature n ms) :
    exchangeArgs r q (exchangeArgs q p (exchangeArgs p r args)) = exchangeArgs p q args := by
  match args with
  | .nil => rfl
  | .cons t rest =>
      change Arg.cons _ _ = Arg.cons _ _
      rw [exchange_three p q r hpq hpr hqr, exchangeArgs_three p q r hpq hpr hqr]
termination_by structural args
end

/-- Every exchange is generated by fresh renamings. When both names are declared,
    a third fresh name witnesses three such renamings, without any runtime step. -/
theorem State.Exchange.alpha {p q s t} (h : State.Exchange p q s t) : s.Alpha t := by
  by_cases same : p = q
  · subst q
    have e := h.fixed (by
      intro r _
      by_cases eqn : p = r
      · subst r; exact name_exchange_left p p
      · exact name_exchange_other eqn eqn)
    subst t
    exact .refl s
  by_cases hp : p ∈ domain s.signature
  · by_cases hq : q ∈ domain s.signature
    · obtain ⟨r, fresh⟩ := s.signature.exists_fresh
      have hpr : p ≠ r := fun e => fresh (e ▸ hp)
      have hqr : q ≠ r := fun e => fresh (e ▸ hq)
      let s₁ := exchangedState p r s
      let s₂ := exchangedState q p s₁
      let s₃ := exchangedState r q s₂
      have h₁ := exchangedState_spec p r s
      have h₂ := exchangedState_spec q p s₁
      have h₃ := exchangedState_spec r q s₂
      have q₁ : q ∈ domain s₁.signature := by
        have hm := exchange_domain h₁.signature q hq
        simpa only [name_exchange_other same hqr.symm] using hm
      have p₁ : p ∉ domain s₁.signature := by
        intro hm
        have e := exchange_domain h₁.symm.signature p hm
        rw [name_exchange_left] at e
        exact fresh e
      have r₁ : r ∈ domain s₁.signature := by
        have hm := exchange_domain h₁.signature p hp
        simpa only [name_exchange_left] using hm
      have r₂ : r ∈ domain s₂.signature := by
        have hm := exchange_domain h₂.signature r r₁
        simpa only [name_exchange_other hqr hpr] using hm
      have q₂ : q ∉ domain s₂.signature := by
        intro hm
        have e := exchange_domain h₂.symm.signature q hm
        rw [name_exchange_left] at e
        exact p₁ e
      have composed : State.Exchange p q s s₃ := by
        refine ⟨?_, ?_, ?_⟩
        · intro a
          rw [← name_exchange_three p q r a same hpr hqr, h₃.signature, h₂.signature, h₁.signature]
        · rw [h₃.focus, h₂.focus, h₁.focus, exchange_three p q r same hpr hqr]
        · intro a
          rw [← name_exchange_three p q r a same hpr hqr, h₃.mapping, h₂.mapping, h₁.mapping]
          simp only [Option.map_map, Function.comp_def, exchange_three p q r same hpr hqr]
      have eqn : s₃ = t := composed.unique h
      exact eqn ▸ State.Alpha.trans (.rename hp fresh h₁)
        (.trans (.rename q₁ p₁ h₂) (.rename r₂ q₂ h₃))
    · exact .rename hp hq h
  · by_cases hq : q ∈ domain s.signature
    · have pt : p ∈ domain t.signature := by
        simpa only [name_exchange_right] using exchange_domain h.signature q hq
      have qt : q ∉ domain t.signature := by
        intro hq'
        have e := exchange_domain h.symm.signature q hq'
        rw [name_exchange_right] at e
        exact hp e
      exact .symm (.rename pt qt h.symm)
    · have e := h.fixed (by
        intro r hr
        exact name_exchange_other (fun eqn => hp (eqn ▸ hr)) (fun eqn => hq (eqn ▸ hr)))
      subst t
      exact .refl s

/-- R-Alpha, Ok clause, along the equivalence generated by fresh renamings. -/
theorem State.Alpha.ok_iff {s t : State} (h : s.Alpha t) : s.Ok ↔ t.Ok := by
  induction h with
  | rename _ _ he => exact ⟨he.ok, he.symm.ok⟩
  | refl => exact Iff.rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- R-Alpha, finality clause; no Ok premise is required. -/
theorem State.Alpha.final_iff {s t : State} (h : s.Alpha t) : s.Final ↔ t.Final := by
  induction h with
  | rename _ _ he => exact ⟨he.final, he.symm.final⟩
  | refl => exact Iff.rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

-- The same equivalence-chain induction serves the local and interleaving relations.
-- Both directions are carried so the symmetry constructor needs no extra assumption.
private theorem State.Alpha.transport (R : State → State → Prop)
    (ex : ∀ {p q s t u}, State.Exchange p q s t → R s u → ∃ v, R t v ∧ State.Exchange p q u v)
    {s t : State} (h : s.Alpha t) :
    (∀ u, R s u → ∃ v, R t v ∧ u.Alpha v) ∧
    (∀ v, R t v → ∃ u, R s u ∧ v.Alpha u) := by
  induction h with
  | rename _ _ he =>
      constructor
      · intro u hu; obtain ⟨v, hv, eqn⟩ := ex he hu; exact ⟨v, hv, eqn.alpha⟩
      · intro v hv; obtain ⟨u, hu, eqn⟩ := ex he.symm hv; exact ⟨u, hu, eqn.alpha⟩
  | refl => exact ⟨fun u hu => ⟨u, hu, .refl u⟩, fun u hu => ⟨u, hu, .refl u⟩⟩
  | symm _ ih => exact ⟨ih.2, ih.1⟩
  | trans _ _ ih₁ ih₂ =>
      constructor
      · intro u hu
        obtain ⟨v, hv, eq₁⟩ := ih₁.1 u hu
        obtain ⟨w, hw, eq₂⟩ := ih₂.1 v hv
        exact ⟨w, hw, .trans eq₁ eq₂⟩
      · intro w hw
        obtain ⟨v, hv, eq₂⟩ := ih₂.2 w hw
        obtain ⟨u, hu, eq₁⟩ := ih₁.2 v hv
        exact ⟨u, hu, .trans eq₂ eq₁⟩

/-- R-Alpha, local transition clause: one matching step with alpha-equivalent targets. -/
theorem State.Alpha.local_step {s t u : State} (h : s.Alpha t) (step : s.LocalStep u) :
    ∃ v, t.LocalStep v ∧ u.Alpha v :=
  (h.transport State.LocalStep (fun he rule => he.local_step rule)).1 u step

/-- R-Alpha, interleaving transition clause, for either selection of the next step. -/
theorem State.Alpha.step {s t u : State} (h : s.Alpha t) (step : Step s u) :
    ∃ v, Step t v ∧ u.Alpha v :=
  (h.transport Step (fun he rule => he.step rule)).1 u step

end SourceRuntime.Runtime
