(rule
 (alias runtest)
 (action
  (progn
   (with-stdout-to source_cli.output
    (run %{exe:../bin/source.exe} %{dep:../examples/runtime.async}))
   (with-stdout-to runtime_cli.output
    (run %{exe:../bin/runtime.exe} %{dep:../examples/runtime.async}))
   (diff runtime_cli.expected source_cli.output)
   (diff source_cli.output runtime_cli.output))))
